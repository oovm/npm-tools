{
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "cargo build --release",
        "build:napi": "node scripts/build-napi.mjs",
        "test": "cargo test --release --workspace",
        "test:ci-gates": "node --test scripts/ci/require-ci-success.test.mjs scripts/ci/publish-npm-classify.test.mjs",
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "nifty update",
        "bump": "nifty bump",
        "publish": "nifty publish",
        "trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/nifty": "workspace:*",
        "@napi-rs/cli": "^2.18.4"
    }
}
