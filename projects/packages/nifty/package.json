{
    "name": "@doki-land/nifty",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/npm-tools.git",
        "directory": "projects/packages/nifty"
    },
    "version": "0.1.10",
    "description": "Gitmoji-first commit conventions and release helpers (Node-API + TypeScript)",
    "type": "module",
    "engines": {
        "node": ">=24.12.0"
    },
    "license": "MPL-2.0",
    "types": "./dist/index.d.ts",
    "bin": {
        "nifty": "cli/nifty.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cli": {
            "types": "./dist/cli/index.d.ts",
            "default": "./dist/cli/index.js"
        }
    },
    "files": [
        "cli/nifty.mjs",
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepublishOnly": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "pretest": "tsc -p tsconfig.build.json",
        "test": "node --test tests/*.test.mjs"
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@doki-land/nifty-darwin-arm64": "workspace:*",
        "@doki-land/nifty-darwin-x64": "workspace:*",
        "@doki-land/nifty-linux-arm64": "workspace:*",
        "@doki-land/nifty-linux-x64": "workspace:*",
        "@doki-land/nifty-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "typescript": "^5.8.3"
    }
}
