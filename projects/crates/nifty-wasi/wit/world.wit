package doki:land;

/// Nifty default convention: gitmoji-prefixed commit subjects and release grouping.
interface gitmoji {
  record github-author {
    id: option<u64>,
    login: option<string>,
  }

  record parsed-subject {
    gitmoji: option<string>,
    body: string,
    section: string,
  }

  known-gitmojis: func() -> list<string>;
  validate-subject: func(subject: string) -> bool;
  parse-subject: func(subject: string) -> parsed-subject;
  format-subject: func(gitmoji: string, body: string) -> string;
  strip-gitmoji: func(subject: string) -> string;
  leading-gitmoji: func(subject: string) -> option<string>;
  section-for-gitmoji: func(gitmoji: option<string>) -> string;
  parse-noreply-email: func(email: string) -> option<github-author>;
  resolve-github-author: func(email: string, author-map-json: string) -> option<github-author>;
  display-login: func(author: github-author) -> string;
  profile-url: func(author: github-author) -> string;
  avatar-url: func(author: github-author) -> string;
  author-mention: func(email: string, author-name: string, author-map-json: string) -> string;
  commit-bullet: func(body: string, email: string, author-name: string, author-map-json: string) -> string;
}

/// Read-only git repository helpers (gix, no `git` subprocess).
interface git {
  record tag-info {
    name: string,
    short-hash: string,
  }

  record range-info {
    version: string,
    from-ref: option<string>,
    to-ref: string,
  }

  record commit-record {
    hash: string,
    email: string,
    author: string,
    subject: string,
    body: string,
    gitmoji: option<string>,
    section: string,
  }

  discover-root: func(start-path: string) -> result<string, string>;
  list-version-tags: func(repo-root: string) -> result<list<string>, string>;
  list-tag-infos: func(repo-root: string) -> result<list<tag-info>, string>;
  format-tag-list: func(repo-root: string) -> result<string, string>;
  resolve-range: func(
    repo-root: string,
    version: option<string>,
    from-ref: option<string>,
    to-ref: option<string>,
  ) -> result<range-info, string>;
  collect-commits: func(repo-root: string, from-ref: option<string>, to-ref: string) -> result<list<commit-record>, string>;
  detect-github-repo: func(repo-root: string) -> result<option<string>, string>;
  parse-github-remote: func(url: string) -> option<string>;
}

/// GitHub REST API user lookup (host networking; unavailable on WASI until HTTP is wired).
interface github {
  use gitmoji.{github-author};

  user-by-login: func(login: string, token: option<string>) -> result<github-author, string>;
  search-user-by-email: func(email: string, token: string) -> result<option<github-author>, string>;
  lookup-user-by-email: func(
    email: string,
    author-map-json: string,
    token: option<string>,
    fetch: bool,
  ) -> result<option<github-author>, string>;
}

world nifty {
  export gitmoji;
  export git;
  export github;
}
